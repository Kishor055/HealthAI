rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // --- USER DATA SILO ---
    // This match covers the user document and ALL nested sub-resources (healthRecords, medicines, etc.)
    match /users/{userId} {
      // Standard CRUD for the user document
      allow get, list, write: if isOwner(userId);
      
      // Recursive wildcard to ensure all subcollections inherit owner permissions
      match /{allPaths=**} {
        allow get, list, write: if isOwner(userId);
      }
    }

    // --- GLOBAL DATA ---
    match /healthcareProviders/{id} { 
      allow read: if true; 
    }
    match /healthcareFacilities/{id} { 
      allow read: if true; 
    }
  }
}