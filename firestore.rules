rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // --- USER DATA SILO ---
    // This match explicitly covers the user document and all sub-resources (subcollections)
    match /users/{userId} {
      allow get, list, write: if isOwner(userId);
      
      // Recursive wildcard to ensure subcollections like healthRecords, medicines, etc. 
      // inherit the same owner-based permissions.
      match /{allPaths=**} {
        allow get, list, write: if isOwner(userId);
      }
    }

    // --- GLOBAL DATA ---
    match /healthcareProviders/{id} { 
      allow read: if true; 
    }
    match /healthcareFacilities/{id} { 
      allow read: if true; 
    }
  }
}