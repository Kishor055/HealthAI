rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * GLOBAL PERMISSIVE RULES FOR PROTOTYPING
     * Force Deployment Trigger: 2024-05-22T12:00:00Z
     * This allows unrestricted access for both authenticated and unauthenticated (guest) users.
     */
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}