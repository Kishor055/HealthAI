rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- GLOBAL BYPASS FOR CLINICAL PROTOTYPING ---
    // This allows unrestricted access to all collections (users, healthRecords, appointments, etc.)
    // to resolve the 'Missing or insufficient permissions' errors during development.
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
