rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * HEALTHAI PRO — Enterprise Multi-Role Clinical Security Policy
     * Strictly enforces Patient, Doctor, Admin, and Researcher boundaries.
     */
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return request.auth.token.email == 'kishorkakde026@gmail.com' || 
             getUserData().role == 'admin';
    }

    function isDoctor() {
      return getUserData().role == 'doctor' || getUserData().role == 'clinician';
    }

    function isResearcher() {
      return getUserData().role == 'researcher';
    }

    function isAuthorizedDoctorFor(userId) {
      return isDoctor() && (
        request.auth.uid in get(/databases/$(database)/documents/users/$(userId)).data.authorizedDoctorIds ||
        userId in getUserData().assignedPatientIds
      );
    }

    // ── User Profiles ────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isDoctor() || isAdmin());
      allow write: if isSignedIn() && (isOwner(userId) || isAdmin());
      
      // Patient Clinical Collections
      match /healthRecords/{id} { 
        allow read: if isSignedIn() && (isOwner(userId) || isAuthorizedDoctorFor(userId) || isAdmin());
        allow write: if isSignedIn() && (isOwner(userId) || isAuthorizedDoctorFor(userId) || isAdmin()); 
      }
      match /appointments/{id} { 
        allow read: if isSignedIn() && (isOwner(userId) || isDoctor() || isAdmin());
        allow write: if isSignedIn() && (isOwner(userId) || isDoctor() || isAdmin()); 
      }
      match /medicines/{id} { 
        allow read: if isSignedIn() && (isOwner(userId) || isAuthorizedDoctorFor(userId) || isAdmin());
        allow write: if isSignedIn() && (isOwner(userId) || isAuthorizedDoctorFor(userId) || isAdmin()); 
      }
      match /medicationIntakes/{id} { 
        allow read: if isSignedIn() && (isOwner(userId) || isAuthorizedDoctorFor(userId) || isAdmin());
        allow write: if isSignedIn() && (isOwner(userId) || isAdmin()); 
      }
      match /emergencyContacts/{id} { 
        allow read: if isSignedIn() && (isOwner(userId) || isDoctor() || isAdmin());
        allow write: if isSignedIn() && (isOwner(userId) || isAdmin()); 
      }
      match /reminders/{id} { 
        allow read, write: if isSignedIn() && (isOwner(userId) || isAdmin()); 
      }
      match /prescriptions/{id} { 
        allow read: if isSignedIn() && (isOwner(userId) || isAuthorizedDoctorFor(userId) || isAdmin());
        allow write: if isSignedIn() && (isOwner(userId) || isAuthorizedDoctorFor(userId) || isAdmin()); 
      }
      match /labReports/{id} { 
        allow read: if isSignedIn() && (isOwner(userId) || isAuthorizedDoctorFor(userId) || isAdmin());
        allow write: if isSignedIn() && (isOwner(userId) || isAuthorizedDoctorFor(userId) || isAdmin()); 
      }
      match /medicalDocuments/{id} { 
        allow read: if isSignedIn() && (isOwner(userId) || isAuthorizedDoctorFor(userId) || isAdmin());
        allow write: if isSignedIn() && (isOwner(userId) || isAuthorizedDoctorFor(userId) || isAdmin()); 
      }
      match /symptomChecks/{id} { 
        allow read, write: if isSignedIn() && (isOwner(userId) || isAuthorizedDoctorFor(userId) || isAdmin()); 
      }
      match /clinicalNotes/{id} {
        allow read: if isSignedIn() && (isOwner(userId) || isDoctor() || isAdmin());
        allow write: if isSignedIn() && (isDoctor() || isAdmin());
      }
    }

    // ── Enterprise Audit Logs (Append-Only for Users, Read for Admins) ────────
    match /audit_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update, delete: if false; // Immutable audit log
    }

    // ── Anonymized Research Repository ───────────────────────────────────────
    match /anonymized_research_data/{datasetId} {
      allow read: if isSignedIn() && (isResearcher() || isAdmin());
      allow write: if isAdmin();
    }

    // ── Internal Authentication Logs ─────────────────────────────────────────
    match /otp_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
