rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * GLOBAL BYPASS FOR CLINICAL PROTOTYPING
     * Triggered deployment: 2024-05-20T10:00:00Z
     * This allows unrestricted access to all medical collections.
     */
    match /{allPaths=**} {
      allow read, write: if true;
      allow get, list, create, update, delete: if true;
    }
  }
}