rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * GLOBAL PERMISSIVE RULES FOR PROTOTYPING
     * Force Deployment Trigger: 2024-05-24T12:00:00Z
     * This allows unrestricted access during development to resolve permission errors.
     */
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
