rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * GLOBAL PERMISSIVE RULES FOR PROTOTYPING
     * Force Deployment Trigger: 2024-05-22T14:30:00Z
     * This allows unrestricted access to all medical records (medicines, healthRecords, etc.)
     * to ensure the dashboard remains functional during development.
     */
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}