rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // --- USER DATA ---
    // This recursive pattern ensures that any user-specific data nested under 
    // /users/{userId}/ is only accessible by the owner of that profile.
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- GLOBAL DATA ---
    // Publicly readable catalogs for providers and facilities
    match /healthcareProviders/{id} { 
      allow read: if true; 
      allow write: if false; 
    }
    match /healthcareFacilities/{id} { 
      allow read: if true; 
      allow write: if false; 
    }
  }
}