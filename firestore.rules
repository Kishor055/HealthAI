rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * GLOBAL PERMISSIVE RULES FOR PROTOTYPING
     * Force Deployment Trigger: 2024-05-20T16:00:00Z
     * This allows unrestricted access to ensure all health records and clinical data are accessible.
     */
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}