rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // --- USER DATA SILO ---
    // Explicitly grant access to the user document and all nested medical resources
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Recursive wildcard ensures healthRecords, appointments, medicines, etc. inherit permissions
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- GLOBAL DATA ---
    match /healthcareProviders/{id} { 
      allow read: if true; 
    }
    match /healthcareFacilities/{id} { 
      allow read: if true; 
    }
  }
}