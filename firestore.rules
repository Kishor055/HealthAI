
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * GLOBAL PROTOTYPING BYPASS
     * Forced Deployment Trigger: 2024-06-01T16:00:00Z
     * This rule ensures unrestricted access to medical collections during active development.
     */
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
