rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // --- USER DATA SILO ---
    // This match covers the user document itself and ALL nested subcollections
    // (prescriptions, medicines, healthRecords, appointments, medicationIntakes, etc.)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- GLOBAL DATA ---
    // Publicly readable catalogs for providers and facilities
    match /healthcareProviders/{id} { 
      allow read: if true; 
      allow write: if false; 
    }
    match /healthcareFacilities/{id} { 
      allow read: if true; 
      allow write: if false; 
    }
  }
}