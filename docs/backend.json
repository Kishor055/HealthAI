{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the HealthAI application, linked to an external authentication system.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "createdAt"]
    },
    "HealthRecord": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "HealthRecord",
      "type": "object",
      "description": "Biometric data point or vital sign manually logged by the user.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["Blood Pressure", "Heart Rate", "Blood Sugar", "Temperature", "Weight"] },
        "value": { "type": "string" },
        "unit": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      },
      "required": ["id", "userId", "type", "value", "unit", "date"]
    },
    "Appointment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Appointment",
      "type": "object",
      "description": "Scheduled medical consultation with a preferred provider.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "providerId": { "type": "string" },
        "providerName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "userId", "providerId", "date", "time", "status"]
    },
    "Medicine": {
      "title": "Medicine",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "dosage": { "type": "string" },
        "category": { "type": "string" },
        "isActive": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "User" }
      },
      {
        "path": "/users/{userId}/healthRecords/{recordId}",
        "definition": { "entityName": "HealthRecord" }
      },
      {
        "path": "/users/{userId}/appointments/{appointmentId}",
        "definition": { "entityName": "Appointment" }
      },
      {
        "path": "/users/{userId}/medicines/{medicineId}",
        "definition": { "entityName": "Medicine" }
      }
    ]
  }
}