
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user of the HealthAI application.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "createdAt"]
    },
    "HealthRecord": {
      "title": "HealthRecord",
      "type": "object",
      "description": "Biometric data point or vital sign manually logged by the user.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["Blood Pressure", "Heart Rate", "Blood Sugar", "Temperature", "Weight"] },
        "value": { "type": "string" },
        "unit": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      },
      "required": ["id", "userId", "type", "value", "unit", "date"]
    },
    "Appointment": {
      "title": "Appointment",
      "type": "object",
      "description": "Scheduled medical consultation.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "providerId": { "type": "string" },
        "providerName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "userId", "providerId", "date", "time", "status"]
    },
    "Medicine": {
      "title": "Medicine",
      "type": "object",
      "description": "A medication entry.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "dosage": { "type": "string" },
        "category": { "type": "string" },
        "isActive": { "type": "boolean" },
        "startDate": { "type": "string" },
        "frequency": { "type": "string" },
        "instructions": { "type": "string" }
      }
    },
    "MedicationIntake": {
      "title": "MedicationIntake",
      "type": "object",
      "description": "Record of when a medication was taken.",
      "properties": {
        "userId": { "type": "string" },
        "medicineName": { "type": "string" },
        "actualTakeTime": { "type": "string", "format": "date-time" },
        "status": { "type": "string" }
      }
    },
    "EmergencyContact": {
      "title": "EmergencyContact",
      "type": "object",
      "description": "Personal emergency contact information.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "relationship": { "type": "string" },
        "phone": { "type": "string" }
      },
      "required": ["name", "phone"]
    },
    "Reminder": {
      "title": "Reminder",
      "type": "object",
      "description": "A manual reminder for a specific medication or health task.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "time": { "type": "string" },
        "days": { "type": "array", "items": { "type": "string" } },
        "isEnabled": { "type": "boolean" }
      },
      "required": ["title", "time"]
    },
    "PrescriptionRecord": {
      "title": "PrescriptionRecord",
      "type": "object",
      "description": "A digitized record of an uploaded or pasted prescription.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "diagnosis": { "type": "string" },
        "medications": { "type": "array" },
        "source": { "type": "string", "enum": ["file", "text"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "diagnosis", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "google", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "User profile document."
    },
    "/users/{userId}/healthRecords/{recordId}": {
      "schema": { "$ref": "#/backend/entities/HealthRecord" },
      "description": "Collection of biometric health logs."
    },
    "/users/{userId}/appointments/{appointmentId}": {
      "schema": { "$ref": "#/backend/entities/Appointment" },
      "description": "User medical appointments."
    },
    "/users/{userId}/medicines/{medicineId}": {
      "schema": { "$ref": "#/backend/entities/Medicine" },
      "description": "User medication list."
    },
    "/users/{userId}/medicationIntakes/{intakeId}": {
      "schema": { "$ref": "#/backend/entities/MedicationIntake" },
      "description": "Logs of medication adherence."
    },
    "/users/{userId}/emergencyContacts/{contactId}": {
      "schema": { "$ref": "#/backend/entities/EmergencyContact" },
      "description": "User's trusted emergency contacts."
    },
    "/users/{userId}/reminders/{reminderId}": {
      "schema": { "$ref": "#/backend/entities/Reminder" },
      "description": "Manual health and medication reminders."
    },
    "/users/{userId}/preferredProviders/{providerId}": {
      "schema": { "type": "object" },
      "description": "Saved favorite healthcare facilities."
    },
    "/users/{userId}/prescriptions/{prescriptionId}": {
      "schema": { "$ref": "#/backend/entities/PrescriptionRecord" },
      "description": "History of digitized medical records."
    }
  }
}
